[all]
%{ for idx, ip in private_ips ~}
host${idx + 1} ansible_host=${ip}
%{ endfor ~}
[kube_control_plane]
%{ for idx, ip in private_ips ~}
host${idx + 1}
%{ endfor ~}
[etcd]
%{ for idx, ip in private_ips ~}
host${idx + 1}
%{ endfor ~}
[kube_node]
%{ for idx, ip in private_ips ~}
host${idx + 1}
%{ endfor ~}
[k8s-cluster:children]
kube_node
kube_control_plane
